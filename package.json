{
  "name": "agents",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "validate": "tsx tools/validate.ts",
    "build:lease": "tsc -p tsconfig.lease.json",
    "install-lease": "npm run build:lease && tsx tools/install-lease.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run validate && npm run build && git diff --exit-code -- skills",
    "install-home": "tsx tools/install-home.ts",
    "hidden": "tsx tools/run-hidden.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "6.4.4",
    "vitest": "5.0.4"
  }
}
