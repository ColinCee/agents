{
  "name": "agents",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "validate": "tsx tools/validate.ts",
    "build:run-job": "tsc -p tsconfig.run-job.json",
    "install-run-job": "npm run build:run-job && tsx tools/install-run-job.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run validate",
    "install-home": "tsx tools/install-home.ts",
    "hidden": "tsx tools/run-hidden.ts",
    "keep-going": "tsx tools/keep-going.ts",
    "rule-changes": "tsx tools/rule-changes.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "6.4.4",
    "vitest": "5.0.4"
  }
}
