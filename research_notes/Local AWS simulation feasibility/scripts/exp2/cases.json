[
 {
  "id": "prefix-yes",
  "desc": "prefix match",
  "event": {
   "k": "us-east-1"
  },
  "pattern": {
   "k": [
    {
     "prefix": "us-"
    }
   ]
  },
  "expected": true
 },
 {
  "id": "prefix-no",
  "desc": "prefix no match",
  "event": {
   "k": "eu-west-1"
  },
  "pattern": {
   "k": [
    {
     "prefix": "us-"
    }
   ]
  },
  "expected": false
 },
 {
  "id": "prefix-ci",
  "desc": "prefix equals-ignore-case",
  "event": {
   "k": "US-east"
  },
  "pattern": {
   "k": [
    {
     "prefix": {
      "equals-ignore-case": "us-"
     }
    }
   ]
  },
  "expected": true
 },
